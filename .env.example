# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=servicedesk
MYSQL_USER=servicedesk_user
MYSQL_PASSWORD=change-me

# Porty
MYSQL_PORT=3307
PHPMYADMIN_PORT=8081

# Konto administratora (tworzone przy starcie API)
ADMIN_EMAIL=admin@servicedesk.local
ADMIN_PASSWORD=change-me

# JWT signing key (min. 32 chars)
JWT_KEY=generate-with-openssl-rand-base64-48

# Prefiksy kodow kreskowych EAN-13 (4 cyfry): prefiks + zera + id = 13 cyfr
BARCODE_ASSET_PREFIX=1001
BARCODE_TICKET_PREFIX=2001
BARCODE_ASSET_CATEGORY_PREFIX=3001
